# Copy this file to .env and fill in only the values you need locally.
# Do not commit the real .env file.

# --- Application -----------------------------------------------
APP_NAME=UNIPLANE AI Platform
APP_ENV=development
DEBUG=true

# --- JWT Auth --------------------------------------------------
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# --- Database --------------------------------------------------
# Default to SQLite for local development. Replace with Postgres if needed.
DATABASE_URL=sqlite:///./k8sai.db

# --- Redis -----------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- AI Providers ----------------------------------------------
AI_PROVIDER=auto
GENERAL_CHAT_PROVIDER=default
ANTHROPIC_API_KEY=<your_anthropic_api_key>
ANTHROPIC_MODEL=claude-sonnet-4-20250514
GITHUB_MODELS_TOKEN=<your_github_models_token>
GITHUB_MODELS_ENDPOINT=https://models.inference.ai.azure.com/chat/completions
GITHUB_MODELS_MODEL=openai/gpt-4.1-mini

# --- Kubernetes ------------------------------------------------
# Comma-separated kubeconfig paths when not using in-cluster auth.
K8S_KUBECONFIG_PATHS=~/.kube/config
K8S_USE_IN_CLUSTER=false

# --- MCP -------------------------------------------------------
MCP_ENABLED=true
MCP_STRICT_MODE=true
MCP_CLUSTER_ENDPOINTS=
MCP_TIMEOUT_SECONDS=10
MCP_GKE_KUBECONFIG_PATHS=
MCP_EKS_KUBECONFIG_PATHS=
MCP_AKS_KUBECONFIG_PATHS=

# Rancher API mode: use one or more API endpoints and tokens.
MCP_RANCHER_ENDPOINTS=
MCP_RANCHER_API_URL_SANDBOX=https://rancher.example.internal
MCP_RANCHER_API_TOKEN_SANDBOX=<your_rancher_sandbox_token>
MCP_RANCHER_API_URL_EKS=https://rancher-eks.example.internal
MCP_RANCHER_API_TOKEN_EKS=<your_rancher_eks_token>
MCP_RANCHER_API_URL=
MCP_RANCHER_API_TOKEN=
MCP_RANCHER_REGION=on-prem

# Rancher kubeconfig fallback mode.
MCP_RANCHER_KUBECONFIG_PATHS=

# Datadog MCP targets, if used.
MCP_DATADOG_TARGETS=

# --- Vault -----------------------------------------------------
VAULT_URL=http://localhost:8200
VAULT_TOKEN=root

# --- Datadog ---------------------------------------------------
DATADOG_API_KEY=
DATADOG_APP_KEY=
DATADOG_SITE=datadoghq.com

# --- Safety guards ---------------------------------------------
PROD_MUTATION_REQUIRE_APPROVAL=true
MAX_MEMORY_LIMIT_GB=10
